# =============================================================================
# Emotion Recognition (ER) — .gitignore
# Ship: extractors + multimodal_classifier + format docs + env specs.
# Do not ship: raw data, features, scrapers, MTG, legacy one-offs.
# =============================================================================

# --- OS / editor / Python ---
.DS_Store
.AppleDouble
.LSOverride
.cursor/
.cursorignore
.vscode/
.idea/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
er.egg-info/
.eggs/
dist/
build/
*.egg
.ipynb_checkpoints/

# --- Secrets / local env ---
.env
.env.*
!.env.example

# --- Runtime outputs & experiment tracking ---
wandb/
**/wandb/
outputs/
**/outputs/
*.log
hs-*.log

# --- Large / local data ---
raw_data/

# Precomputed embeddings / features / checkpoints
*.pt
*.pk
*.pkl
*.npy
*.npz
*.h5
*.ckpt
*.pth
*.bin
*.onnx

# Media
*.mp4
*.mov
*.avi
*.mkv
*.flv
*.wav
*.mp3
*.flac
*.ogg
*.m4a
*.webm

# Archives
*.zip
*.tar
*.tar.gz
*.tgz
*.7z

# Local dumps / notebooks / ad-hoc results (keep code; drop data-shaped files)
*.csv
*.json
*.ipynb
# Local YAML configs (VER/environment.yml uses .yml and is tracked)
*.yaml

# Shipped song-disjoint partition tables (exception to *.csv)
!partitions/
!partitions/**/
!partitions/**/*.csv
!partitions/**/*.txt
!partitions/**/*.md

